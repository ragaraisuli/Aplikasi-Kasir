{
  "name": "kasir-desktop",
  "version": "1.0.0",
  "description": "Aplikasi Kasir Desktop Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.kasir.desktop",
    "productName": "Kasir Desktop",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "jimp": "^1.6.1"
  }
}
